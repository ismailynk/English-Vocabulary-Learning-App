<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".trToIng"
    tools:layout_editor_absoluteX="0dp"
    tools:layout_editor_absoluteY="8dp">

    <TextView
        android:id="@+id/textViewTurk"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="74dp"
        android:layout_marginBottom="106dp"
        android:text="TextView"
        android:textSize="34sp"
        app:layout_constraintBottom_toTopOf="@+id/buttonA2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/buttonA2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="35dp"
        android:layout_weight="1"
        android:background="#DDFFBC"
        android:gravity="center_horizontal"
        android:text="Button"
        android:textColor="#52734D"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/buttonB2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewTurk" />

    <Button
        android:id="@+id/buttonB2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="22dp"
        android:layout_weight="1"
        android:background="#DDFFBC"
        android:gravity="center_horizontal"
        android:text="Button"
        android:textColor="#52734D"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/buttonC2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonA2" />

    <Button
        android:id="@+id/buttonC2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:layout_weight="1"
        android:background="#DDFFBC"
        android:gravity="center_horizontal"
        android:text="Button"
        android:textColor="#52734D"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/buttonD2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonB2" />

    <Button
        android:id="@+id/buttonD2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="37dp"
        android:layout_weight="1"
        android:background="#DDFFBC"
        android:gravity="center_horizontal"
        android:text="Button"
        android:textColor="#52734D"
        android:textSize="30sp"
        app:layout_constraintBottom_toTopOf="@+id/buttonOk2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonC2" />

    <Button
        android:id="@+id/buttonOk2"
        android:layout_width="112dp"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:text="Button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttonD2" />

</android.support.constraint.ConstraintLayout>