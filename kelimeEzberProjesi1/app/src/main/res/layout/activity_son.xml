<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Son">

    <Button
        android:id="@+id/buttonTekrar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="63dp"
        android:text="Tekrar"
        app:layout_constraintBaseline_toBaselineOf="@+id/buttonAnaSayfa"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/buttonAnaSayfa"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="187dp"
        android:text="Ana sayfa"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textViewPuan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginBottom="99dp"
        app:layout_constraintBottom_toTopOf="@+id/buttonTekrar"
        app:layout_constraintStart_toEndOf="@+id/buttonTekrar" />
</android.support.constraint.ConstraintLayout>